from fpdf import FPDF



# Criar a classe personalizada do PDF

class PDF(FPDF):

    def header(self):

        # Título principal com espaço para foto ao lado

        self.set_font("Arial", "B", 14)

        self.cell(140, 10, "Ryan Ribeiro Da Cunha", ln=0)

        self.rect(160, 10, 30, 40)  # Espaço para a foto 3x4

        self.ln(7)

        self.set_font("Arial", "", 11)

        self.cell(140, 10, "Telefone: (86) 99554-3680", ln=1)

        self.cell(140, 10, "E-mail: ryanribeiro230207@gmail.com", ln=1)

        self.ln(5)



    def section_title(self, title):

        self.set_font("Arial", "B", 12)

        self.set_text_color(0)

        self.cell(0, 10, title, ln=1)



    def section_body(self, body_lines):

        self.set_font("Arial", "", 11)

        for line in body_lines:

            self.multi_cell(0, 8, line)

        self.ln(3)



# Criar o PDF

pdf = PDF()

pdf.add_page()



